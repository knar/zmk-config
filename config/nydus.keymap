#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                /* left */
                &kp ESC &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7
                &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7
                &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y
                &kp CAPS &kp A &kp S &kp D &kp F &kp G &kp H
                &kp LSHIFT &kp Z &kp X &kp C &kp V &kp B &kp N
                &kp LCTRL &kp LMETA &kp LALT &mo 1 &kp SPACE

                /* right */
                &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &kp PSCRN &kp PAUSE_BREAK &kp DEL
                &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSPC
                &kp Y &kp U &kp I &kp O &kp P &kp LBKT &kp RBKT &kp NUBS
                &kp H &kp J &kp K &kp L &kp SEMI &kp APOS &kp RET
                &kp N &kp M &kp COMMA &kp DOT &kp SLASH &kp RSHIFT &mo 1
                &kp SPACE &kp RALT &kp RCTRL &kp LEFT &kp DOWN &kp UP &kp RIGHT
            >;
        };
        
        fn_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &bootloader
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans

                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
